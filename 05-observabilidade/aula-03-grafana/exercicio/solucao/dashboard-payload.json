{
  "dashboard": {
    "id": null,
    "title": "task-api",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Requisicoes por segundo",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "targets": [
          { "expr": "rate(task_api_requests_total[5m])", "refId": "A" }
        ]
      },
      {
        "id": 2,
        "title": "Taxa de erro (4xx+5xx)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "targets": [
          { "expr": "rate(task_api_requests_total{status=~\"4..|5..\"}[5m])", "refId": "A" }
        ]
      },
      {
        "id": 3,
        "title": "Latencia p95",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "targets": [
          { "expr": "histogram_quantile(0.95, rate(task_api_request_duration_seconds_bucket[5m]))", "refId": "A" }
        ]
      }
    ],
    "schemaVersion": 39,
    "version": 0
  },
  "overwrite": true
}
